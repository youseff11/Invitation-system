# انسخ هذا الملف إلى .env وعدّل القيم. لا ترفع .env إلى Git أبداً.

# التطوير المحلي فقط
DJANGO_DEBUG=1

# ---- الإنتاج ----
# ولّد مفتاحاً بـ:
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# DJANGO_SECURE_SSL_REDIRECT=1

# قاعدة البيانات — اتركه فارغاً لاستخدام SQLite محلياً
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# بيانات الموقع
SITE_NAME=ليلة
SITE_TAGLINE=دعوات رقمية تليق بلحظاتكم
SITE_CURRENCY=ج.م
# SITE_WHATSAPP=201000000000
# SITE_EMAIL=hello@example.com

# حد إرسال تأكيدات الحضور لكل زائر في الساعة
RSVP_RATE_LIMIT_PER_HOUR=12
